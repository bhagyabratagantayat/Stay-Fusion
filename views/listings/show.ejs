<% layout('layouts/boilerplate') -%>

    <div class="row mt-3">
        <div class="col-8 offset-2">
            <h3>
                <%= listing.title %>
            </h3>
        </div>

        <!-- Featured Image / Gallery -->
        <div class="col-8 offset-2 mt-2">
            <div class="card listing-card show-card border-0">
                <div id="listingCarousel" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        <% let images=(listing.images && listing.images.length> 0) ? listing.images :
                            ["https://images.unsplash.com/photo-1480074568708-e7b720bb3f09?q=80&w=1174&auto=format&fit=crop"];
                            %>
                            <% images.forEach((img, index)=> { %>
                                <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                                    <img src="<%= img %>" class="d-block w-100 show-img" alt="listing_image"
                                        style="height: 30rem; object-fit: cover; border-radius: 1rem;">
                                </div>
                                <% }) %>
                    </div>
                    <% if (listing.images.length> 1) { %>
                        <button class="carousel-control-prev" type="button" data-bs-target="#listingCarousel"
                            data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#listingCarousel"
                            data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                        <% } %>
                </div>

                <div class="card-body px-0 mt-3">
                    <p class="card-text">
                        <span class="badge rounded-pill bg-dark mb-2">
                            <%= listing.propertyType || "Property" %>
                        </span>
                        <% if (listing.status) { %>
                            <span class="status-badge-inline <%= listing.status.toLowerCase() %> ms-2">
                                <%= listing.status %>
                            </span>
                            <% } %>
                    </p>
                    <p class="card-text"><i>Owned by Stay Fusion Host</i></p>
                    <p class="card-text">
                        <%= listing.description %>
                    </p>
                    <p class="card-text fw-bold fs-5">&#8377; <%= (listing.price || 0).toLocaleString("en-IN") %> /
                            night</p>
                    <p class="card-text"><i class="fa-solid fa-location-dot me-2"></i>
                        <%= listing.location %>, <%= listing.country %>
                    </p>

                    <hr>

                    <div class="row mt-4">
                        <div class="col-6 col-md-3 text-center border-end">
                            <i class="fa-solid fa-bed fs-4"></i>
                            <p class="mb-0">
                                <%= listing.bedrooms %> Bedrooms
                            </p>
                        </div>
                        <div class="col-6 col-md-3 text-center border-end">
                            <i class="fa-solid fa-bath fs-4"></i>
                            <p class="mb-0">
                                <%= listing.bathrooms %> Bathrooms
                            </p>
                        </div>
                    </div>

                    <hr>

                    <h5 class="mt-4">What this place offers</h5>
                    <div class="row mt-3">
                        <% if (listing.amenities && listing.amenities.length> 0) { %>
                            <% listing.amenities.forEach(amenity=> { %>
                                <div class="col-6 col-md-4 mb-3">
                                    <i class="fa-solid fa-circle-check text-success me-2"></i>
                                    <%= amenity %>
                                </div>
                                <% }) %>
                                    <% } else { %>
                                        <p class="text-muted">No amenities listed.</p>
                                        <% } %>
                    </div>
                </div>
            </div>

            <div class="btns mb-5 d-flex gap-3">
                <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn px-4">Edit</a>
                <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                    <button class="btn btn-outline-danger px-4">Delete</button>
                </form>
            </div>
        </div>
    </div>