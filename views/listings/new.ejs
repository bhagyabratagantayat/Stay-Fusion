<% layout('layouts/boilerplate') -%>

<body>
    <h3>Create New Listing</h3>
    <form method="POST" action="/listings">
        <input type="text" name="listing[title]" placeholder="Title" required><br> <br>
        <textarea name="listing[description]" placeholder="Description" required></textarea><br><br>
        <input type="text" name="listing[image]" placeholder="Image URL" ><br><br>
        <input type="number" name="listing[price]" placeholder="Price per night" required><br><br>
        <input type="text" name="listing[location]" placeholder="Location" required><br><br>
        <input type="text" name="listing[country]" placeholder="Country" required><br><br>
        <button type="submit">Create Listing</button>
    </form>

</body>
