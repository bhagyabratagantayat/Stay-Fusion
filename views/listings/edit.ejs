<% layout('layouts/boilerplate') -%>

<body>
    <h3>Edit Listing</h3>
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT">
        <input type="hidden" name="_method" value="PUT">
        <input type="text" name="listing[title]" placeholder="Title" value="<%= listing.title %>" required><br> <br>
        <textarea name="listing[description]" placeholder="Description" required><%= listing.description %></textarea><br><br>
        <input type="text" name="listing[image]" placeholder="Image URL" value="<%= listing.image %>"><br><br>
        <input type="number" name="listing[price]" placeholder="Price per night" value="<%= listing.price %>" required><br><br>
        <input type="text" name="listing[location]" placeholder="Location" value="<%= listing.location %>" required><br><br>
        <input type="text" name="listing[country]" placeholder="Country" value="<%= listing.country %>" required><br><br>
        <button type="submit">Update Listing</button>
    </form>

</body>
