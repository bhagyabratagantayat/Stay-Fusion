<% layout('layouts/boilerplate') -%>

    <!-- Search and Filter Bar -->
    <div class="row mt-3 mb-4">
        <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2">
            <form class="d-flex flex-sm-row flex-column" role="search" action="/listings" method="GET">
                <input class="form-control me-0 me-sm-2 mb-2 mb-sm-0 search-input" type="search" name="q"
                    placeholder="Search destinations" aria-label="Search" value="<%= locals.searchQuery || '' %>">
                <button class="btn btn-search" type="submit"><i class="fa-solid fa-magnifying-glass"></i>
                    Search</button>
            </form>
        </div>
    </div>

    <div id="filters" class="d-flex align-items-center mb-4 overflow-auto pb-2">
        <div class="filter <%= (locals.activeType === '' || !locals.activeType) ? 'active-filter' : '' %>">
            <a href="/listings" class="filter-link">
                <div><i class="fa-solid fa-fire"></i></div>
                <p>Trending</p>
            </a>
        </div>
        <div class="filter <%= locals.activeType === 'House' ? 'active-filter' : '' %>">
            <a href="/listings?type=House" class="filter-link">
                <div><i class="fa-solid fa-house"></i></div>
                <p>House</p>
            </a>
        </div>
        <div class="filter <%= locals.activeType === 'Apartment' ? 'active-filter' : '' %>">
            <a href="/listings?type=Apartment" class="filter-link">
                <div><i class="fa-solid fa-city"></i></div>
                <p>Apartment</p>
            </a>
        </div>
        <div class="filter <%= locals.activeType === 'Villa' ? 'active-filter' : '' %>">
            <a href="/listings?type=Villa" class="filter-link">
                <div><i class="fa-solid fa-umbrella-beach"></i></div>
                <p>Villa</p>
            </a>
        </div>
        <div class="filter <%= locals.activeType === 'Cabin' ? 'active-filter' : '' %>">
            <a href="/listings?type=Cabin" class="filter-link">
                <div><i class="fa-solid fa-mountain"></i></div>
                <p>Cabin</p>
            </a>
        </div>
        <div class="filter <%= locals.activeType === 'Castle' ? 'active-filter' : '' %>">
            <a href="/listings?type=Castle" class="filter-link">
                <div><i class="fa-solid fa-fort-awesome"></i></div>
                <p>Castle</p>
            </a>
        </div>

        <!-- Status Filters -->
        <div class="ms-auto d-flex">
            <div class="filter <%= locals.activeStatus === 'Available' ? 'active-filter' : '' %>">
                <a href="/listings?status=Available" class="filter-link">
                    <div><img src="/assets/available.png" alt="Available" class="filter-img"></div>
                    <p>Available</p>
                </a>
            </div>
            <div class="filter <%= locals.activeStatus === 'Sold' ? 'active-filter' : '' %>">
                <a href="/listings?status=Sold" class="filter-link">
                    <div><img src="/assets/sold.png" alt="Sold" class="filter-img"></div>
                    <p>Sold</p>
                </a>
            </div>
        </div>
    </div>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">
        <% if (allListings.length===0) { %>
            <div class="col-12 text-center mt-5">
                <h3>No listings found.</h3>
                <p class="text-muted">Try adjusting your search or filters.</p>
            </div>
            <% } %>
                <% for(let listing of allListings) { %>
                    <div class="col">
                        <a href="/listings/<%= listing._id %>" class="listing-link">
                            <div class="card listing-card h-100">
                                <div class="position-relative">
                                    <% let displayImg=(listing.images && listing.images.length> 0) ? listing.images[0] :
                                        "https://images.unsplash.com/photo-1480074568708-e7b720bb3f09?q=80&w=1174&auto=format&fit=crop";
                                        %>
                                        <img src="<%= displayImg %>" class="card-img-top" alt="listing_image"
                                            style="height: 18rem; object-fit: cover;">
                                        <% if (listing.status) { %>
                                            <div class="status-badge <%= listing.status.toLowerCase() %>">
                                                <%= listing.status %>
                                            </div>
                                            <% } %>
                                </div>
                                <div class="card-body px-0">
                                    <p class="card-text mt-2">
                                        <span class="text-muted small">
                                            <%= listing.propertyType || "Property" %> in <%= listing.location %>
                                        </span> <br>
                                        <b>
                                            <%= listing.title %>
                                        </b> <br>
                                        &#8377; <%= (listing.price || 0).toLocaleString("en-IN") %> / night
                                    </p>
                                </div>
                            </div>
                        </a>
                    </div>
                    <% } %>
    </div>

    <!-- Pagination -->
    <% if (totalPages> 1) { %>
        <nav aria-label="Page navigation" class="mt-5 mb-5">
            <ul class="pagination justify-content-center">
                <% for(let i=1; i <=totalPages; i++) { %>
                    <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                        <a class="page-link"
                            href="/listings?page=<%= i %><%= searchQuery ? '&q=' + searchQuery : '' %><%= activeType ? '&type=' + activeType : '' %><%= activeStatus ? '&status=' + activeStatus : '' %>">
                            <%= i %>
                        </a>
                    </li>
                    <% } %>
            </ul>
        </nav>
        <% } %>